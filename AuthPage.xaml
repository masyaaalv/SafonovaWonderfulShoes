<Page x:Class="SafonovaWonderfulShoes.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SafonovaWonderfulShoes"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AuthPage" FontFamily="Calibri">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
       
        <TextBlock Text="Вход в систему Чудо Обувь" Grid.Row="0" FontSize="35" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Grid.Row="1">
            <TextBlock Text="Поле для ввода логин:" Grid.Row="1" FontSize="20"/>
            <TextBox Name="TBLogin" FontSize="25" Width="400" Height="30" VerticalAlignment="Center" Margin="0,30,0,10"/>
            <Button Name="LoginBtn" Content="Войти " Click="LoginBtn_Click"/>
        </StackPanel>
        <Button Name="GuestBtn" Content="Войти как гость" Grid.Row="2" Width="150" Click="GuestBtn_Click"  />
    </Grid>
</Page>
