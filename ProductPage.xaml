<Page x:Class="SafonovaWonderfulShoes.ProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SafonovaWonderfulShoes"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProductPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Строка с информацией о пользователе -->
        <Grid Grid.Row="0" Margin="10,10,10,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Row="0" Margin="10,10,10,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Пустая левая часть -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Вы вошли как:" FontSize="14" Margin="0,0,20,0"/>
                </StackPanel>

                <!-- ФИО и роль справа -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Name="FIOTB" 
                   VerticalAlignment="Center" 
                   Margin="0,0,20,0"
                   FontSize="14"/>

                    <TextBlock Text="Ваша роль:" FontSize="14" Margin="0,0,20,0"/>


                    <TextBlock Name="RoleTB" 
                   VerticalAlignment="Center"
                   FontSize="14"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Строка с поиском, фильтрами и сортировкой -->
        <Grid Grid.Row="1" Margin="10,5,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Поиск -->
            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="Поиск по наименованию" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,5"/>
                <TextBox Name="SearchTBox" 
                     TextChanged="SearchTBox_TextChanged" 
                     Width="200" 
                     Height="22"/>
            </StackPanel>

            <!-- Фильтрация -->
            <StackPanel Grid.Column="1" Margin="10,0,10,0">
                <TextBlock Text="Фильтрация по категории" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,5"/>
                <ComboBox Name="FilterCBox" SelectionChanged="FilterCBox_SelectionChanged_1" Width="200">
                    <ComboBoxItem Content="Все"/>
                    <ComboBoxItem Content="Детская обувь"/>
                    <ComboBoxItem Content="Женская обувь"/>
                    <ComboBoxItem Content="Мужская обувь"/>
                </ComboBox>

            </StackPanel>

            <!-- Сортировка -->
            <StackPanel Grid.Column="2" Margin="10,0,0,0">
                <TextBlock Text="Сортировать по" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,5"/>
                <ComboBox Name="SortTB" SelectionChanged="SortTB_SelectionChanged" Width="200">
                    <ComboBoxItem Content="Все"/>
                    <ComboBoxItem Content="по наименованию от А до Я"/>
                    <ComboBoxItem Content="по наименованию от Я до А"/>
                    <ComboBoxItem Content="По возрастанию цены"/>
                    <ComboBoxItem Content="По убыванию цены"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <!-- ListView с товарами -->
        <!-- Строка 3: ListView с товарами -->
        <ListView Name="ProductListView" 
          Grid.Row="2" 
          Margin="10"
          HorizontalContentAlignment="Stretch"
          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#CCCCCC" BorderThickness="1" Padding="10" Margin="5" CornerRadius="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>

                            <!-- Изображение товара -->
                            <Image Grid.Column="0" 
                       Width="130" 
                       Height="130"
                       Stretch="Uniform" 
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">
                                <Image.Source>
                                    <Binding Path="ProductPhotoPath" Mode="OneWay">
                                        <Binding.TargetNullValue>
                                            <BitmapImage UriSource="/res/picture.png"/>
                                        </Binding.TargetNullValue>
                                    </Binding>
                                </Image.Source>
                            </Image>

                            <!-- Информация о товаре -->
                            <StackPanel Grid.Column="1" Margin="10,0">
                                <TextBlock FontSize="16" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,5">
                        <Run Text="{Binding Product_Name, Mode=OneWay}"/>
                        <Run Text=" | "/>
                        <Run Text="{Binding ManufactureTitle, Mode=OneWay}"/>
                                </TextBlock>

                                <TextBlock Text="{Binding CategoryTitle, Mode=OneWay}" 
                               FontSize="13"
                               Foreground="#666"
                               Margin="0,0,0,3"/>

                                <TextBlock Text="{Binding CountProduct, Mode=OneWay, StringFormat='Количество: {0} шт.'}" 
                               FontSize="13"
                               Margin="0,0,0,3"/>

                                <TextBlock Text="{Binding Discribtion, Mode=OneWay}" 
                               FontSize="12" 
                               TextWrapping="Wrap"
                               Margin="0,0,0,3"/>
                            </StackPanel>

                            <!-- Цена -->
                            <StackPanel Grid.Column="2"  
                            VerticalAlignment="Center" 
                            HorizontalAlignment="Center">
                                <TextBlock Text="Цена:" 
                               FontSize="14"
                               HorizontalAlignment="Center"
                               Foreground="#666"/>
                                <TextBlock Text="{Binding Cost, Mode=OneWay}" 
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#2E7D32"
                               HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
